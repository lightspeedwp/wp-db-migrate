# WP DB Migrate Configuration

# Claude API Configuration (for task budgets)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ANTHROPIC_API_URL: Only set if using a proxy or custom endpoint
# ⚠️  SECURITY: Only approved hosts allowed (api.anthropic.com, localhost:3000/8000)
# Default (if not set): https://api.anthropic.com
# Uncomment only if using an approved proxy:
# ANTHROPIC_API_URL=https://api.anthropic.com

CLAUDE_MODEL=claude-opus-4-1

# GitHub Configuration (for GitHub backup setup)
# For private repositories, set one of:
GITHUB_TOKEN=ghp_your_token_here
# OR configure SSH (no env var needed, uses ~/.ssh/id_rsa)

# Task Budget Configuration
TASK_BUDGET_SIMPLE=32000
TASK_BUDGET_MEDIUM=64000
TASK_BUDGET_COMPLEX=128000

# Automation Defaults
AUTO_CREATE_SITE=true
AUTO_DETECT_COMPLEXITY=true
AUTO_CLEANUP_TEMP=true

# Studio CLI Configuration
STUDIO_SITES_PATH=$HOME/Studio
STUDIO_CLI_VERSION=latest

# Migration Defaults
DEFAULT_DRY_RUN=false
DEFAULT_AUTO_START=true
DEFAULT_AUTO_BACKUP=true
DEFAULT_VERBOSE=false
