# WordPress Database Migration - Environment Configuration
# Copy this to .env and customize for your environment

# ═══════════════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════════════

# Application environment (development, production, test)
NODE_ENV=production

# Enable debug output (development, production, disabled)
DEBUG=

# Enable verbose logging
VERBOSE=false

# ═══════════════════════════════════════════════════════════════════════════
# Database Settings
# ═══════════════════════════════════════════════════════════════════════════

# Source database type (mysql, mariadb)
SOURCE_DB_TYPE=mysql

# Source database host
SOURCE_DB_HOST=localhost

# Source database port
SOURCE_DB_PORT=3306

# Source database name
SOURCE_DB_NAME=wordpress

# Source database user
SOURCE_DB_USER=root

# Source database password
SOURCE_DB_PASSWORD=

# Source database charset
SOURCE_DB_CHARSET=utf8mb4

# ═══════════════════════════════════════════════════════════════════════════
# WordPress Studio Settings
# ═══════════════════════════════════════════════════════════════════════════

# Path to WordPress Studio site directory
STUDIO_PATH=~/.studio

# Target SQLite database path (relative to studio site)
SQLITE_PATH=wordpress.sqlite

# ═══════════════════════════════════════════════════════════════════════════
# Migration Settings
# ═══════════════════════════════════════════════════════════════════════════

# Current site URL (will be auto-detected if not set)
CURRENT_URL=

# New/target site URL
TARGET_URL=

# Enable dry-run mode by default
DRY_RUN=false

# Skip backup before import (dangerous - not recommended)
SKIP_BACKUP=false

# Force migration without confirmation prompts
FORCE=false

# Tables to exclude from migration (comma-separated)
EXCLUDE_TABLES=wp_actionscheduler_logs,wp_actionscheduler_failed_logs

# Backup retention days (delete backups older than this)
BACKUP_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════
# Export Settings
# ═══════════════════════════════════════════════════════════════════════════

# Export file format (sql, gz)
EXPORT_FORMAT=sql

# Export file location
EXPORT_PATH=./exports

# ═══════════════════════════════════════════════════════════════════════════
# Logging Settings
# ═══════════════════════════════════════════════════════════════════════════

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/migration.log

# Keep log files for this many days
LOG_RETENTION_DAYS=7

# ═══════════════════════════════════════════════════════════════════════════
# API & Integration Settings
# ═══════════════════════════════════════════════════════════════════════════

# WordPress REST API URL (for validation)
WP_REST_API=

# WordPress admin user (for validation)
WP_ADMIN_USER=

# WordPress admin password (for validation)
WP_ADMIN_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# Timeout Settings
# ═══════════════════════════════════════════════════════════════════════════

# Import operation timeout (seconds)
IMPORT_TIMEOUT=600

# URL replacement timeout (seconds)
REPLACE_TIMEOUT=300

# Validation timeout (seconds)
VALIDATE_TIMEOUT=120

# ═══════════════════════════════════════════════════════════════════════════
# Cloud Provider Settings
# ═══════════════════════════════════════════════════════════════════════════

# Deployment environment (local, aws, gcp, azure, digitalocean)
CLOUD_PROVIDER=local

# AWS settings (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GCP settings (if using GCP)
GCP_PROJECT_ID=
GCP_CREDENTIALS=

# Digital Ocean settings (if using DigitalOcean)
DO_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# Notification Settings
# ═══════════════════════════════════════════════════════════════════════════

# Enable notifications
ENABLE_NOTIFICATIONS=false

# Slack webhook URL (for notifications)
SLACK_WEBHOOK=

# Email for notifications
NOTIFY_EMAIL=

# ═══════════════════════════════════════════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════════════════════════════════════════

# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Enable profiling/performance metrics
ENABLE_PROFILING=false

# Enable health checks
ENABLE_HEALTH_CHECKS=true

# ═══════════════════════════════════════════════════════════════════════════
# Development Settings (only used in development environment)
# ═══════════════════════════════════════════════════════════════════════════

# Run tests after setup
RUN_TESTS=true

# Keep containers running after completion (for testing)
KEEP_RUNNING=false

# Mock external APIs (for testing)
MOCK_APIS=false

# Test database name (for CI/CD)
TEST_DB_NAME=wordpress_test
