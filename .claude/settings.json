{
  "projectName": "wp-db-migrate",
  "description": "Professional WordPress database migration skill for MySQL→SQLite migrations to WordPress Studio",
  "version": "1.1.0",
  "settings": {
    "model": "claude-opus-5-5",
    "effort": "medium",
    "outputStyle": "concise",
    "fastMode": false
  },
  "permissions": {
    "allow": [
      "npm test",
      "npm run lint",
      "grep",
      "find"
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    ".git/",
    "dist/",
    "coverage/",
    ".DS_Store",
    "*.swp"
  ],
  "aliases": {
    "test": "npm test",
    "test:watch": "npm run test:watch",
    "test:verbose": "npm run test:verbose",
    "lint": "npm run lint",
    "check": "./skill/scripts/preflight-check.sh",
    "help": "less ./skill/SKILL.md"
  },
  "testing": {
    "framework": "Jest",
    "testMatch": "**/skill/scripts/__tests__/**/*.test.js",
    "testEnvironment": "node",
    "testTimeout": 120000,
    "coverage": true,
    "bashCompatibility": "3.2+",
    "commands": {
      "test": "npm test -- with coverage",
      "testWatch": "npm run test:watch -- continuous testing",
      "testVerbose": "npm run test:verbose -- detailed output",
      "testSingle": "npm test -- <filename>.test.js"
    },
    "coLocation": {
      "description": "Jest tests are co-located with source scripts following Jest best practices",
      "location": "skill/scripts/__tests__/",
      "pattern": "Tests placed alongside shell scripts in __tests__ folder"
    },
    "integration": {
      "framework": "BATS",
      "location": "tests/",
      "description": "End-to-end shell script integration testing",
      "commands": {
        "testBats": "npm run test:bats -- runs integration tests",
        "testBatsVerbose": "npm run test:bats:verbose -- verbose output",
        "testAll": "npm run test:all -- runs Jest + BATS"
      },
      "requirements": {
        "install": "brew install bats-core (macOS) or sudo apt-get install bats (Linux)"
      }
    }
  },
  "skills": [
    "wp-db-migrate"
  ],
  "documentation": {
    "main": "README.md",
    "setup": "docs/SETUP-REQUIREMENTS.md",
    "guide": "docs/GETTING-STARTED.md",
    "testing": "docs/TESTING.md",
    "best-practices": "docs/BEST-PRACTICES.md",
    "troubleshooting": "docs/TROUBLESHOOTING.md",
    "faq": "docs/FAQ.md",
    "integration": "docs/LS-HOSTING-INTEGRATION.md",
    "advanced": "docs/ADVANCED.md",
    "analytics": "docs/ANALYTICS.md",
    "configuration": "docs/CONFIGURATION.md",
    "large-databases": "docs/LARGE-DATABASES.md",
    "reliability": "docs/RELIABILITY.md",
    "api": "skill/SKILL.md",
    "agents": "AGENTS.md",
    "claude": "CLAUDE.md",
    "bats": "tests/README.md"
  }
}
