{
  "version": "1.0.0",
  "projectName": "WordPress Database Migration",
  "description": "Professional-grade skill for migrating WordPress databases from MySQL/MariaDB to SQLite in WordPress Studio",
  "homepage": "https://github.com/lightspeedwp/wp-db-migrate",
  "repositoryUrl": "https://github.com/lightspeedwp/wp-db-migrate.git",
  "author": "Ash Shaw",
  "authorEmail": "ashley@lightspeedwp.agency",
  "license": "MIT",
  "version": "1.1.0",
  "scripts": {
    "setup": "./setup-cloud.sh",
    "setup:prod": "./setup-cloud.sh --production --ci",
    "setup:verbose": "./setup-cloud.sh --verbose",
    "test": "npm test",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "preflight": "./skill/scripts/preflight-check.sh",
    "migrate": "./skill/scripts/migrate-recovery.sh",
    "docker:build": "docker build -t wp-db-migrate:latest .",
    "docker:dev": "docker-compose up dev",
    "docker:test": "docker-compose up test",
    "docker:down": "docker-compose down"
  },
  "hooks": {
    "startup": {
      "description": "Initialize environment on session start",
      "script": "./setup-cloud.sh --skip-tests",
      "showOutput": true,
      "exitOnError": false,
      "timeout": 300
    },
    "postInstall": {
      "description": "Run after npm install",
      "script": "npm run preflight",
      "showOutput": true,
      "exitOnError": false
    }
  },
  "permissions": {
    "bash": {
      "allowed": [
        "./setup-cloud.sh",
        "./skill/scripts/*.sh",
        "npm",
        "node",
        "docker",
        "docker-compose",
        "git",
        "grep",
        "sed"
      ]
    }
  },
  "environment": {
    "NODE_ENV": "development",
    "DEBUG": "wp-db-migrate:*"
  },
  "recommendations": {
    "extensions": [
      "shellcheck"
    ],
    "tools": [
      "Node.js 20.x or later",
      "npm or yarn",
      "Docker (for containerized development)",
      "WordPress CLI (for local testing)"
    ]
  },
  "documentation": {
    "gettingStarted": "README.md",
    "cloudSetup": "CLOUD-SETUP.md",
    "quickReference": "CLOUD-QUICK-REFERENCE.md",
    "skillGuide": "skill/SKILL.md",
    "securityFixes": "SECURITY-FIXES.md"
  },
  "keywords": [
    "wordpress",
    "database",
    "migration",
    "sqlite",
    "mysql",
    "claude-skill",
    "wordpress-studio"
  ],
  "features": [
    "MySQL to SQLite migration",
    "Dry-run mode for preview",
    "Automated backups with rollback",
    "URL replacement in database",
    "Table exclusion for optimization",
    "Comprehensive validation",
    "Docker deployment ready",
    "GitHub Actions CI/CD",
    "Cloud provider support"
  ],
  "supportedPlatforms": [
    "macOS",
    "Linux (Debian, RHEL, Alpine)",
    "Docker",
    "GitHub Actions",
    "AWS",
    "Google Cloud",
    "Azure",
    "DigitalOcean"
  ]
}
