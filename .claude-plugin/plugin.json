{
	"$schema": "https://raw.githubusercontent.com/hesreallyhim/claude-code-json-schema/refs/heads/main/schemas/plugin.schema.json",
	"name": "WordPress Database Migration",
	"id": "wp-db-migrate",
	"version": "1.1.0",
	"description": "Migrate WordPress databases from MySQL/MariaDB to SQLite in WordPress Studio. Features smart table exclusion analysis, safe import with backup & rollback, automatic URL replacement with dry-run verification, post-import validation, visual progress tracking, and configuration file support.",
