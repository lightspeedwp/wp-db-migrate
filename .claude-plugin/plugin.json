		"name": "Ash Shaw",
		"email": "ashley@lightspeedwp.agency"
	},
	"repository": "https://github.com/lightspeedwp/wp-db-migrate",
	"homepage": "https://github.com/lightspeedwp/wp-db-migrate",
	"license": "MIT",
	"skills": [
		"./skill/SKILL.md"
	],
	"keywords": [
		"wordpress",
		"database",
		"migration",
		"mysql",
		"sqlite",
		"studio",
		"export",
		"import",
		"backup",
		"cli"
	],
	"requirements": {
		"cli": [
			"studio",
			"wp"
		],
		"tools": [
			"bash",
			"grep",
			"sed",
			"sqlite3"
		],
		"features": [
			"bash-execution",
			"file-operations",
			"database-access"
		]
	}
}
