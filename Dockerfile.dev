# Dockerfile.dev - Development environment with testing and linting tools
# Usage: docker build -f Dockerfile.dev -t wp-db-migrate:dev .

FROM node:22-alpine

WORKDIR /app

# Install development and system dependencies
RUN apk add --no-cache \
    bash \
    curl \
    git \
    jq \
    grep \
    sed \
    ca-certificates \
    shellcheck \
    make

# Copy package files
COPY package*.json ./

# Install all dependencies (including devDependencies)
RUN npm ci

# Copy project files
COPY . .

# Make scripts executable
RUN chmod +x skill/scripts/*.sh

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S claude -u 1001

# Change ownership
RUN chown -R claude:nodejs /app

USER claude

# Set environment variables for development
ENV NODE_ENV=development
ENV DEBUG=wp-db-migrate:*
ENV PATH="/app/skill/scripts:/app/node_modules/.bin:${PATH}"

# Set npm cache directory for non-root user
ENV npm_config_cache=/tmp/.npm

# Default to bash shell
CMD ["bash"]

# Labels
LABEL maintainer="Ash Shaw <ashley@lightspeedwp.agency>"
LABEL environment="development"
LABEL version="1.1.0"
