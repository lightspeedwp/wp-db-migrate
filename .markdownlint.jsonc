{
  // Markdown linting rules for wp-db-migrate
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

  "default": true,

  // Line length
  "MD013": {
    "line_length": 120,
    "code_blocks": false,
    "code_lines": false,
    "headers": false,
    "headers_line_length": 120,
    "tables": false
  },

  // No bare URLs
  "MD034": false,

  // Emphasis style
  "MD036": false,

  // Inline HTML
  "MD033": false,

  // Multiple spaces in code
  "MD038": false,

  // Ordered list prefixes - too strict for complex docs
  "MD029": false,

  // Link fragments - documentation has custom anchors
  "MD051": false,

  // Table column style - allows compact formatting
  "MD060": false,

  // Blanks around fences - sometimes intentional
  "MD031": false
}
