# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# JavaScript
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Git-related files
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tar binary
*.zip binary

# Make shell scripts executable
*.sh eol=lf diff=sh
skill/scripts/*.sh diff=sh export-ignore
