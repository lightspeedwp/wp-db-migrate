{
  "name": "wp-db-migrate",
  "version": "1.1.0",
  "description": "WordPress database migration skill for MySQL→SQLite in WordPress Studio",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    "migrate:budget": "node skill/api/migrate-with-budget.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "__tests__/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "wordpress",
    "database",
    "migration",
    "sqlite",
    "mysql"
  ],
  "author": "Ash Shaw",
  "license": "MIT"
}
