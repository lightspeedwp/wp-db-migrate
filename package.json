{
  "name": "wp-db-migrate",
  "version": "1.1.0",
  "description": "WordPress database migration skill for MySQL→SQLite in WordPress Studio",
  "main": "index.js",
  "scripts": {
    "prepare": "lefthook install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "migrate:budget": "node skill/api/migrate-with-budget.js",
    "preflight": "./skill/scripts/preflight-check.sh",
    "setup": "./setup-cloud.sh",
    "setup:prod": "./setup-cloud.sh --production --ci",
    "setup:verbose": "./setup-cloud.sh --verbose",
    "lint": "eslint . --fix 2>/dev/null || true && shellcheck skill/scripts/*.sh 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "lefthook": "^2.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "wordpress",
    "database",
    "migration",
    "sqlite",
    "mysql"
  ],
  "author": "Ash Shaw",
  "license": "MIT"
}
