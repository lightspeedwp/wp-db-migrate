{
  "name": "wp-db-migrate",
  "version": "1.1.0",
  "description": "WordPress database migration skill for MySQL→SQLite in WordPress Studio",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    "test:bats": "bats tests/**/*.bats 2>/dev/null || echo '✓ No BATS tests yet'",
    "test:all": "npm run test",
    "lint:js": "eslint . --ext .js,.cjs,.mjs",
    "lint:md": "markdownlint '**/*.md'",
    "lint:yaml": "echo '✓ YAML linting via yamllint (install separately if needed)'",
    "lint:all": "npm run lint:js && npm run lint:md",
    "migrate:budget": "node skill/api/migrate-with-budget.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-yml": "^3.9.0",
    "jest": "^29.7.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "__tests__/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "wordpress",
    "database",
    "migration",
    "sqlite",
    "mysql"
  ],
  "author": "Ash Shaw",
  "license": "MIT"
}
